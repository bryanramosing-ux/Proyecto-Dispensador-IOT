# Copie a backend/.env (no se sube a GitHub). Todas las variables son opcionales.

# Cámara (obligatoria si no usa el valor por defecto)
ESP32_CAM_URL=http://192.168.1.51
# El ESP32 se descubre solo por su telemetría; defina esto solo como respaldo.
ESP32_URL=

# Token compartido con el ESP32 (TOKEN_DISPOSITIVO en secrets.h). Vacío = sin dispensación remota.
# Genere uno:  python3 -c "import secrets; print(secrets.token_hex(8))"
TOKEN_DISPOSITIVO=

# 0.0.0.0 = accesible desde la LAN (necesario para el ESP32 y el móvil); 127.0.0.1 = solo este PC
HOST=0.0.0.0
PORT=8001
PUERTO_DESCUBRIMIENTO=41234
MAX_PORCIONES=3
MIN_DISPENSE_GAP_S=3
